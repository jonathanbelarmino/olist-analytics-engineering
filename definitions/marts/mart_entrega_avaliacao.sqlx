config {
    type: "table",
    schema: "marts",
    description: "Nota média de avaliação por faixa de prazo de entrega e atraso. Só vendas válidas já entregues e avaliadas.",
    assertions: {
        uniqueKey: ["faixa_entrega", "entregue_com_atraso"],
        nonNull: ["faixa_entrega", "entregue_com_atraso", "qtd_pedidos", "nota_media"]
    }
}

WITH
  entregas AS (
  SELECT
    f.id_pedido,
    DATE_DIFF(DATE(p.data_hora_entrega), f.data_compra, day) AS dias_entrega,
    DATE(p.data_hora_entrega) > p.data_entrega_estimada AS entregue_com_atraso,
    a.nota
  FROM
    ${ref("fct_pedidos")} AS f
  INNER JOIN
    ${ref("stg_pedidos")} AS p
  ON
    f.id_pedido = p.id_pedido
  INNER JOIN
    ${ref("int_avaliacoes_pedido")} AS a
  ON
    f.id_pedido = a.id_pedido
  WHERE
    f.venda_valida
    AND p.data_hora_entrega IS NOT NULL )
SELECT
  CASE
    WHEN dias_entrega <= 7 THEN '1. Até 7 dias'
    WHEN dias_entrega <= 14 THEN '2. 8 a 14 dias'
    WHEN dias_entrega <= 21 THEN '3. 15 a 21 dias'
    WHEN dias_entrega <= 30 THEN '4. 22 a 30 dias'
    ELSE '5. Mais de 30 dias'
END
  AS faixa_entrega,
  entregue_com_atraso,
  COUNT(*) AS qtd_pedidos,
  ROUND(AVG(nota), 2) AS nota_media
FROM
  entregas
GROUP BY
  faixa_entrega,
  entregue_com_atraso
