config {
  type: "table",
  schema: "marts",
  description: "Vendas válidas por mês. Um registro por mês, com faturamento (itens, sem frete), pedidos, clientes e ticket médio.",
  assertions: {
    uniqueKey: ["ano_mes"],
    nonNull: ["ano_mes", "qtd_pedidos", "faturamento"]
  }
}

select
  c.ano_mes,
  c.ano,
  c.mes,
  count(*)                                         as qtd_pedidos,
  count(distinct f.id_cliente_unico)               as qtd_clientes,
  sum(f.valor_itens)                               as faturamento,
  sum(f.valor_frete)                               as valor_frete,
  round(safe_divide(sum(f.valor_itens), count(*)), 2) as ticket_medio
from ${ref("fct_pedidos")} as f
inner join ${ref("dim_calendario")} as c
  on f.data_compra = c.data
where f.venda_valida
group by c.ano_mes, c.ano, c.mes