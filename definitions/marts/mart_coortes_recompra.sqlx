config {
  type: "table",
  schema: "marts",
  description: "Retenção por coorte. Coorte = mês da primeira compra válida do cliente real. Um registro por coorte e por mês desde a primeira compra, incluindo meses sem retorno (zero). Setembro/2018 fica de fora por ter dados incompletos.",
  assertions: {
    uniqueKey: ["coorte_ano_mes", "meses_desde_primeira_compra"],
    nonNull: ["coorte_ano_mes", "meses_desde_primeira_compra", "clientes_na_coorte", "clientes_ativos"]
  }
}

with compras as (
  select
    id_cliente_unico,
    date_trunc(data_compra, month) as mes_compra
  from ${ref("fct_pedidos")}
  where venda_valida
  group by id_cliente_unico, mes_compra
),

primeira as (
  select
    id_cliente_unico,
    min(mes_compra) as mes_coorte
  from compras
  group by id_cliente_unico
),

tamanho as (
  select
    mes_coorte,
    count(*) as clientes_na_coorte
  from primeira
  group by mes_coorte
),

-- último mês com dados completos no dataset
limite as (
  select date '2018-08-01' as mes_final
),

-- uma linha para cada coorte e cada mês possível, tenha ou não havido retorno
grade as (
  select
    t.mes_coorte,
    t.clientes_na_coorte,
    meses_desde_primeira_compra
  from tamanho as t
  cross join limite as l
  cross join unnest(
    generate_array(0, date_diff(l.mes_final, t.mes_coorte, month))
  ) as meses_desde_primeira_compra
),

atividade as (
  select
    p.mes_coorte,
    date_diff(c.mes_compra, p.mes_coorte, month) as meses_desde_primeira_compra,
    count(distinct c.id_cliente_unico)           as clientes_ativos
  from compras as c
  inner join primeira as p
    on c.id_cliente_unico = p.id_cliente_unico
  group by p.mes_coorte, meses_desde_primeira_compra
)

select
  format_date('%Y-%m', g.mes_coorte)                                           as coorte_ano_mes,
  g.meses_desde_primeira_compra,
  g.clientes_na_coorte,
  coalesce(a.clientes_ativos, 0)                                               as clientes_ativos,
  round(safe_divide(coalesce(a.clientes_ativos, 0), g.clientes_na_coorte), 4)  as taxa_retencao
from grade as g
left join atividade as a
  on  g.mes_coorte = a.mes_coorte
  and g.meses_desde_primeira_compra = a.meses_desde_primeira_compra