config {
  type: "view",
  schema: "staging",
  description: "Coordenadas por prefixo de CEP. Tem muitas linhas repetidas por CEP; a deduplicação é feita na camada intermediate.",
  assertions: {
    nonNull: ["cep_prefixo", "latitude", "longitude"]
  }
}

select
  lpad(geolocation_zip_code_prefix, 5, '0') as cep_prefixo,
  cast(geolocation_lat as float64)          as latitude,
  cast(geolocation_lng as float64)          as longitude,
  initcap(geolocation_city)                 as cidade,
  upper(geolocation_state)                  as uf
from ${ref("geolocation")}